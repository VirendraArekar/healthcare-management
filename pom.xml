<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.9</version>
    <relativePath/>
  </parent>
  <groupId>com.hospital</groupId>
  <artifactId>hospital-platform</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <properties>
    <java.version>21</java.version>
    <spring-cloud.version>2025.1.4</spring-cloud.version>
    <postgresql.version>42.7.14</postgresql.version>
  </properties>
  <modules>
    <module>backend/platform-common</module>
    <module>backend/auth-service</module>
    <module>backend/patient-service</module>
    <module>backend/staff-service</module>
    <module>backend/appointment-service</module>
    <module>backend/medical-record-service</module>
    <module>backend/lab-service</module>
    <module>backend/pharmacy-service</module>
    <module>backend/billing-service</module>
    <module>backend/notification-service</module>
    <module>backend/reporting-service</module>
    <module>backend/api-gateway</module>
  </modules>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>1.12.1</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>1.86</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
